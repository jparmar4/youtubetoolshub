# ==============================================================================
# YouTube Tools Hub - Environment Variables Template
# Copy this file to .env.local for local development.
# For Hostinger deployment, add these under "Environment variables" in your dashboard.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE (Hostinger MySQL)
# ------------------------------------------------------------------------------
# Required for user usage tracking, saved cloud history, and Pro subscriptions.
MYSQL_HOST=127.0.0.1
MYSQL_DATABASE=your_database_name
MYSQL_USER=your_database_user
MYSQL_PASSWORD=your_hostinger_mysql_password
MYSQL_PORT=3306
# Alternatively, single connection URL:
# DATABASE_URL=mysql://user:password@localhost:3306/database

# ------------------------------------------------------------------------------
# 2. AI & CREATOR TOOL APIs
# ------------------------------------------------------------------------------
# Free Google Gemini AI API key for Hostinger deployment (Google AI Studio):
GEMINIFREEAI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# Alternatively, OpenAI API key (for OpenAI-powered generation):
AI_API_KEY=your_openai_api_key_here
AI_MODEL=gpt-4o-mini

# Replicate API token for AI thumbnail generation (FLUX / SDXL models)
REPLICATE_API_TOKEN=your_replicate_token_here

# YouTube Data API v3 key for tag extraction, channel audit, and trending data
YOUTUBE_API_KEY=your_youtube_data_api_v3_key_here

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION (NextAuth.js v5 / Auth.js)
# ------------------------------------------------------------------------------
# Random 32+ character secret for JWT signing and session encryption
AUTH_SECRET=your_auth_secret_here

# Production URL for auth callbacks (set to https://www.youtubetoolshub.com in production)
NEXTAUTH_URL=https://www.youtubetoolshub.com
AUTH_URL=https://www.youtubetoolshub.com

# Google OAuth credentials (configured in Google Cloud Console)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# ------------------------------------------------------------------------------
# 4. PAYMENT GATEWAY (Razorpay)
# ------------------------------------------------------------------------------
# Razorpay API credentials for Pro subscriptions (₹499/mo, ₹4,999/yr)
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# ------------------------------------------------------------------------------
# 5. EMAIL / SMTP (Nodemailer for Contact Form)
# ------------------------------------------------------------------------------
# Gmail SMTP or transactional email credentials
EMAIL_USER=support@youtubetoolshub.com
EMAIL_PASS=your_email_app_password

# ------------------------------------------------------------------------------
# 6. SEO & INDEXNOW
# ------------------------------------------------------------------------------
# IndexNow key for instant search engine submission (Bing, Yandex, Naver)
INDEXNOW_KEY=01d46652569c40eaa19149073834de57
INDEXNOW_ADMIN_SECRET=your_secure_random_admin_secret
